# Kopieer naar ~/.config/flower-and-the-dog-mcp/env en zet chmod 600.
# Secrets horen als op://-verwijzing naar de 1Password-kluis "Mac Mini"; run.sh gebruikt dan
# `op run` met het token uit de Keychain. scripts/env-to-op.sh zet platte waarden om.

# Het Funnel-adres, zie `tailscale funnel status`
MCP_PUBLIC_URL=https://<mini>.<tailnet>.ts.net
MCP_PORT=8765
# Wachtwoord voor de inlogpagina bij het koppelen van de connector. Lang en willekeurig.
MCP_LOGIN_PASSWORD=

CARWASH_USERNAME=
CARWASH_PASSWORD=

# Postgres van health-dashboard (stap 1: trainingstools), met een eigen rol `mcp`
HEALTH_DATABASE_URL=postgresql://mcp:@127.0.0.1:5433/health
